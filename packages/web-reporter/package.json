{
  "name": "@briefrepo/web-reporter",
  "version": "0.1.0",
  "description": "BriefRepo Web 报告模板（设计 token + D3/GSAP）",
  "license": "MIT",
  "author": "BriefRepo Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/emVisible/brepo"
  },
  "keywords": ["report", "briefrepo", "d3", "gsap"],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@briefrepo/tokens": "workspace:*",
    "@briefrepo/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0"
  },
  "files": ["dist"]
}
