{
  "name": "@briefrepo/types",
  "version": "0.1.0",
  "description": "BriefRepo 共享类型定义",
  "license": "MIT",
  "author": "BriefRepo Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/emVisible/brepo"
  },
  "keywords": ["types", "briefrepo"],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0"
  },
  "files": ["dist"]
}
